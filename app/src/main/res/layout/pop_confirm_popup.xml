<?xml version="1.0" encoding="utf-8"?>
<!-- 照官 8.83 布局原样重建（apktool 官包 res）：带输入框的确认弹窗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_round_all"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:maxLines="1"
            android:padding="15.0dip"
            android:textColor="@color/blackText"
            android:textSize="18.0sp" />
    </RelativeLayout>

    <EditText
        android:id="@+id/edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginEnd="5.0dip"
        android:layout_marginBottom="10.0dip"
        android:maxHeight="80.0dip"
        android:textColor="@color/blackText"
        android:textColorHint="@color/tabText2"
        android:textSize="14.0sp" />

    <View
        android:id="@+id/xpopup_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dip"
        android:layout_marginTop="20.0dip"
        android:background="@color/_xpopup_list_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50.0dip"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0.0dip"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:text="取消"
            android:textSize="16.0sp" />

        <View
            android:id="@+id/xpopup_divider_h"
            android:layout_width="0.5dip"
            android:layout_height="match_parent"
            android:background="#ffeeeeee" />

        <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="0.0dip"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:text="确认"
            android:textSize="16.0sp" />
    </LinearLayout>
</LinearLayout>
