<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ad_list_window"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    android:contentDescription="背景，点击返回上一级">

    <LinearLayout
        android:id="@+id/ad_list_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="90.0dip"
        android:background="@drawable/shape_top_border_radius"
        android:orientation="vertical"
        android:paddingStart="5.0dip"
        android:paddingTop="15.0dip"
        android:paddingEnd="5.0dip"
        android:paddingBottom="10.0dip">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44.0dip">

            <Button
                android:id="@+id/ad_list_add"
                android:layout_width="66.0dip"
                android:layout_height="28.0dip"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10.0dip"
                android:background="@drawable/button_layer"
                android:text="新增" />

            <Button
                android:id="@+id/ad_list_share"
                android:layout_width="66.0dip"
                android:layout_height="28.0dip"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10.0dip"
                android:layout_toStartOf="@id/ad_list_add"
                android:background="@drawable/button_layer"
                android:text="分享"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ad_list_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5.0dip"
                android:layout_toStartOf="@id/ad_list_add"
                android:ellipsize="end"
                android:lines="1"
                android:maxLines="1"
                android:text="广告过滤"
                android:textColor="@color/black_third"
                android:textSize="20.0sp" />
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ad_list_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</RelativeLayout>
