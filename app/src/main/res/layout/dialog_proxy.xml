<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_glass_white_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proxy"
            android:textColor="#B3000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_reverse"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_shield_btn_ghost"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="倒序"
            android:textColor="#B3000000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/shape_shield_btn_ghost"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="禁用"
            android:textColor="#B3000000"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_shield_proxy_input"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认代理地址"
            android:textColor="#99000000"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_proxy_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="socks5://"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#B3000000"
            android:textColorHint="#60000000"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_suggest"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_btn_blue"
            android:gravity="center"
            android:text="自动建议"
            android:textColor="#B3000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_detect"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_btn_blue"
            android:gravity="center"
            android:text="自动识别"
            android:textColor="#B3000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_test"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_btn_ghost"
            android:gravity="center"
            android:text="测试代理"
            android:textColor="#B3000000"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_shield_tab_bg"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tab_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_tab_selected"
            android:gravity="center"
            android:text="文本"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_edit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="编辑"
            android:textColor="#B3000000"
            android:textSize="14sp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_text"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_shield_proxy_input">

        <TextView
            android:id="@+id/tv_json_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#B3000000"
            android:textSize="13sp"
            android:typeface="monospace" />

    </ScrollView>

    <EditText
        android:id="@+id/et_json_edit"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_shield_proxy_input"
        android:gravity="top"
        android:hint="Raw JSON: {proxy:[{hosts:[example.com],urls:[socks5://...]}]}"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#B3000000"
        android:textColorHint="#60000000"
        android:textSize="13sp"
        android:typeface="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_btn_ghost"
            android:gravity="center"
            android:text="取消"
            android:textColor="#B3000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/shape_shield_btn_blue"
            android:gravity="center"
            android:text="确定"
            android:textColor="#B3000000"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
