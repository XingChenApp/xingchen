<?xml version="1.0" encoding="utf-8"?>
<!-- 模块行：ModuleActivity / ModuleFragment 的 include 目标，binding 字段 icon / title / status / progress。
     progress 必须是 ModuleProgressView（两处 onDestroy 调 progress.setWaveSpeed(0)）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/module_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0C0E12"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#1B2431"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.fongmi.android.tv.ui.custom.ModuleProgressView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
