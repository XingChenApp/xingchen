<?xml version="1.0" encoding="utf-8"?>
<!-- 模块详情弹窗：ModuleDialog 的 binding 字段 module_title / module_status / module_error / btn_test / btn_install / btn_remove / btn_cancel。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_glass_white_sheet"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/module_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#0C0E12"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/module_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1B2431"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/module_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3261E"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/module_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/module_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#1B2431"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/module_test" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_install"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/module_install" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_remove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/module_remove" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/module_cancel" />
    </LinearLayout>
</LinearLayout>
