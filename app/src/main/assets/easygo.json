{
  "easyGoVersion": "1.0",
  "client": "com.example.hikerview",
  "logicEntities": [
    {
      "head": {
        "function": "magicwindow",
        "required": "true"
      },
      "body": {
        "mode": "1",
        "activityPairs": [
          {
            "from": "com.example.hikerview.ui.home.MainActivity",
            "to": "*"
          },
          {
            "from": "com.example.hikerview.ui.home.FilmListActivity",
            "to": "com.example.hikerview.ui.home.FilmListActivity"
          },
          {
            "from": "com.example.hikerview.ui.home.FilmListActivity",
            "to": "com.example.hikerview.ui.video.VideoPlayerActivity"
          },
          {
            "from": "*",
            "to": "com.example.hikerview.ui.video.VideoPlayerActivity"
          }
        ],
        "transActivities": [
        ],
        "Activities": [
          {
            "name": "com.example.hikerview.ui.browser.WebViewActivity",
            "defaultFullScreen": "false"
          },
          {
            "name": "com.tencent.smtt.sdk.VideoActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.view.dialog.GlobalDialogActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.search.GlobalSearchActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.video.EmptyActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.home.ResolveIntentActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.search.EmptySearchActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.browser.PictureListActivity",
            "defaultFullScreen": "true"
          },
          {
            "name": "com.example.hikerview.ui.video.EmptyActivity",
            "defaultFullScreen": "true"
          }
        ],
        "UX": {
          "supportRotationUxCompat": "false",
          "isDraggable": "false",
          "supportDraggingToFullScreen": "PAD|FOLD"
        }
      }
    }
  ]
}