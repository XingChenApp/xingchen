        <!-- documentLaunchMode=never（2026-10-26 订正）：外部应用以 NEW_DOCUMENT 方式
             打开本地视频/链接时，意图必须并回星辰既有任务。intoExisting 只在「已有任务的
             根意图与本次意图全等」时才复用——主任务根意图是 MAIN、文件意图是 VIEW+URI，
             永不相等，所以 intoExisting 在这条路上永远另开一张文档卡（1.4.46 真机仍分裂
             的定罪点）。never 才是把文档意图按普通意图投进既有 affinity 任务的取值。 -->
        <activity
            android:name=".ui.activity.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

