<?xml version="1.0" encoding="utf-8"?>
<!-- 深玻璃面板上的输入框（直播 EPG 弹窗用）：几何与 shape_dialog_glass_input 逐值同，
     只把底换到深色侧——原浅灰 #E0E0E0 压白字恒不可见；深底用衬底定值黑60，描边借既有深面输入框 bg_input_dark 的 #33FFFFFF。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="18dp" />

    <solid android:color="@color/black_60" />

    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />

    <padding
        android:bottom="10dp"
        android:left="14dp"
        android:right="14dp"
        android:top="10dp" />

</shape>
