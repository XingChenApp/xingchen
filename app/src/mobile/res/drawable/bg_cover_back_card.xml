<?xml version="1.0" encoding="utf-8"?>
<!-- 封面卡后叠占位卡底（§15.1-8(a)：竖渐变白 0.08→0.03、描边 1dp/白 0.12、圆角 22dp；无封面动态色） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:startColor="#14FFFFFF"
        android:endColor="#08FFFFFF"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
