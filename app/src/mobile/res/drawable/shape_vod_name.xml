    <corners
        android:bottomLeftRadius="8dp"
        android:bottomRightRadius="8dp" />

    <!-- 白字格名衬底：原 black_20 压任意壁纸对比不足（全查文字对比族），改衬底定值 black_60（与详情批小签同深） -->
