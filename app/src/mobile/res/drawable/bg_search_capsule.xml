<?xml version="1.0" encoding="utf-8"?>
<!-- W2 材料层：液态玻璃件的 XML 可见下限（取样/接线未就绪时照样成形）；运行时由 MusicGlassWire 换同源 MusicGlassDrawable，圆角 999dp 逐件对应。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="999dp" />
    <gradient android:angle="270" android:startColor="#D9FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#CCFFFFFF" />
    <stroke android:width="1dp" android:color="#BFFFFFFF" />
</shape>
