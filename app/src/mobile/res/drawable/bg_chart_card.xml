<?xml version="1.0" encoding="utf-8"?>
<!-- 榜单普通卡底：液态玻璃件的 XML 可见下限（与 bg_music_glass_card 家族同值）；
     运行时由 MusicGlassWire 换同源 MusicGlassDrawable，圆角 16dp 对应。
     此前是不透明白实底 #FFFFFF：未接线/接线落空时整卡变白、且白字压白底；
     2026-10-26 变白收口改回半透玻璃下限，恒不露实白。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="16dp" />
    <gradient android:angle="270" android:startColor="#D9FFFFFF" android:centerColor="#B8FFFFFF" android:endColor="#CCFFFFFF" />
    <stroke android:width="1dp" android:color="#BFFFFFFF" />
</shape>
