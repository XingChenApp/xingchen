<?xml version="1.0" encoding="utf-8"?>
<!-- 8.83 item_movie_tools.xml：ToolsHolder 影片工具卡片（movie_3 用） -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/result_bg"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <RelativeLayout
            android:id="@+id/rl_container"
            android:background="@drawable/hk_ripple_white"
            android:layout_width="match_parent"
            android:layout_height="150dp">
            <ImageView
                android:id="@+id/iv_cover"
                android:background="@drawable/hk_ripple_white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@color/gray_rice"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/tv_desc"
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:background="@drawable/hk_gradient_gray_trans_reverse2"
                android:paddingTop="5dp"
                android:paddingBottom="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_alignParentBottom="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/tv_title"
        android:textColor="#ff222222"
        android:gravity="center"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1" />
</LinearLayout>
