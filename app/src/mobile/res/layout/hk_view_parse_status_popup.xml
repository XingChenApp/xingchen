<?xml version="1.0" encoding="utf-8"?>
<!-- 照抄 8.83 view_setting_menu_popup（ParseStatusListPopup 的实现布局）：标题块默认隐藏，
     白色圆角卡内放队列 RecyclerView；底色 drawable 与色值按原版（bg_round_gray / white） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/hk_bg_round_gray"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/hk_parse_status_title_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip">

            <TextView
                android:id="@+id/hk_parse_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15.0dip"
                android:layout_marginEnd="15.0dip"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lines="1"
                android:maxLines="1"
                android:textColor="#333333"
                android:textSize="20.0sp" />
        </RelativeLayout>
    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15.0dip"
        android:layout_marginTop="15.0dip"
        android:layout_marginEnd="15.0dip"
        android:layout_marginBottom="10.0dip"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10.0dip"
        app:cardElevation="0.0dip">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hk_parse_status_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
