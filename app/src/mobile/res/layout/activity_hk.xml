<?xml version="1.0" encoding="utf-8"?>
<!-- 海阔小程序单页：V1 规则列表 / V2 分类+列表 / V3 搜索结果，三视图栈式切换 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <!-- 液态玻璃动态背景：decor 注入（HkPageActivity.onCreate 调 HkDynamicBgView.attachTo），
         能画到状态栏底下；XML 首孩子在 fitsSystemWindows 根里盖不住状态栏区，已迁走 -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp">

        <!-- ============ V1 规则列表 ============ -->
        <RelativeLayout
            android:id="@+id/view_rules"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 规则列表：内容从顶部开始，滚动时从悬浮磨砂顶栏下穿过 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rules"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/btn_import"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:paddingTop="64dp"
                android:paddingBottom="8dp" />

            <!-- 悬浮磨砂顶栏：背景直接设在 FrameLayout 上，避免内部 match_parent 的 header_bg 测量异常撑满盖住列表 -->
            <!-- 悬浮玻璃顶栏：左右边距与主 App 底栏对齐（外层 16dp，底栏 xc_float_margin=16dp），背景代码设 HkGlassDrawable -->
            <FrameLayout
                android:id="@+id/header_cluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:background="@drawable/hk_header_glass">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 小程序列表顶栏：小程序 …… 右侧 搜索 | 排序 | 编辑（内边距 24dp：胶囊 16dp 边距＋24dp 内边距，
                         两头按钮离屏边 40dp，不贴边；与下方分组 chips 对齐） -->
                    <LinearLayout
                        android:id="@+id/top_bar_rules"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingLeft="24dp"
                        android:paddingRight="24dp">

                        <TextView
                            android:id="@+id/tv_title_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="小程序"
                            android:textColor="#101216"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_search_rule"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="搜索小程序"
                            android:padding="4dp"
                            android:src="@drawable/ic_action_search" />

                        <ImageView
                            android:id="@+id/btn_sort_rule"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="排序"
                            android:padding="4dp"
                            android:src="@drawable/ic_fab_filter"
                            android:tint="#101216" />

                        <!-- 编辑模式才显示：分组管理入口 -->
                        <TextView
                            android:id="@+id/btn_group_manage"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="分组管理"
                            android:textColor="#101216"
                            android:textSize="14sp"
                            android:visibility="gone" />


                        <!-- 多选模式才显示：全选 / 删除 / 完成 -->
                        <TextView
                            android:id="@+id/btn_select_all_rules"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="56dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="全选"
                            android:textColor="#101216"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_delete_selected_rules"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="56dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="删除"
                            android:textColor="#B3261E"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_select_done"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="56dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="完成"
                            android:textColor="#101216"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- 用户拍板（2026-10-23）：历史入口放收藏左边（… 历史/收藏/编辑），与收藏同款胶囊 -->
                        <TextView
                            android:id="@+id/btn_history_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="历史"
                            android:textColor="#101216"
                            android:textSize="14sp" />

                        <!-- 用户拍板：收藏入口放编辑左边（搜索/筛选 … 收藏/编辑），与编辑同款胶囊 -->
                        <TextView
                            android:id="@+id/btn_favorite_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="收藏"
                            android:textColor="#101216"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btn_edit_rule"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hk_btn_glass"
                            android:gravity="center"
                            android:minWidth="64dp"
                            android:paddingLeft="14dp"
                            android:paddingRight="14dp"
                            android:text="编辑"
                            android:textColor="#101216"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_rule_group"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:visibility="gone" />

                    <!-- 首页 inline 搜索条：点 🔍 展开，输入实时过滤小程序卡片，不跳页 -->
                    <LinearLayout
                        android:id="@+id/inline_search_bar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginRight="16dp"
                        android:background="@drawable/hk_searchbar_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingLeft="16dp"
                        android:paddingRight="4dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/et_inline_search"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="搜索小程序"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#101216"
                            android:textColorHint="#4B5563"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/btn_inline_close"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="关闭搜索"
                            android:src="@drawable/ic_hk_close" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/empty_rules"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/hk_capsule_light"
                    android:gravity="center"
                    android:text="海"
                    android:textColor="#D9A420"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="暂无规则"
                    android:textColor="#101216"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点下方按钮导入你的第一条规则"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 奶油玻璃底钮：左右 18dp 悬浮边距（样张定案的 margin 例外），背景/字色代码设 -->
            <TextView
                android:id="@+id/btn_import"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="@drawable/hk_gold_button"
                android:gravity="center"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="＋ 导入规则"
                android:textColor="#101216"
                android:textSize="15sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- ============ V2 分类+列表（Fragment 容器，旧视图已迁入 HkContentFragment） ============ -->
        <FrameLayout
            android:id="@+id/view_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ============ V3 搜索（Fragment 容器，旧视图已迁入 HkSearchFragment） ============ -->
        <FrameLayout
            android:id="@+id/view_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ============ V4 详情（Fragment 容器，旧视图已迁入 HkDetailFragment） ============ -->
        <FrameLayout
            android:id="@+id/view_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
