<?xml version="1.0" encoding="utf-8"?>
<!-- 一键导入勾选弹窗的单个规则项：独立卡片框，项之间用间距隔开。
     根节点必须是 CheckedTextView（TextView 子类），因为 ArrayAdapter(context, layout, list)
     的默认构造要求 layout 根为 TextView，LinearLayout 包裹会导致
     IllegalStateException: ArrayAdapter requires the resource ID to be a TextView -->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:minHeight="54dp"
    android:background="@drawable/dialog_option_card_light"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="48dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:textSize="15sp"
    android:textColor="#101216"
    android:checkMark="?android:attr/listChoiceIndicatorMultiple"
    android:checkMarkTint="#D4A017"
    android:ellipsize="end"
    android:maxLines="1" />
