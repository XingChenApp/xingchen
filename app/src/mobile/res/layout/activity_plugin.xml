<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="插件"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnTabPy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PY"
                android:backgroundTint="#f0a400" />

            <Button
                android:id="@+id/btnTabJs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JS"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- PY Pane -->
        <LinearLayout
            android:id="@+id/panePy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入插件"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持多选，一次可选多个 .py 文件导入"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnImportPy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导入插件" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbSelectAllPy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全选" />

                <TextView
                    android:id="@+id/tvPyCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="共 0 个插件"
                    android:gravity="center"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBatchDelPy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="删除选中"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp" />
        </LinearLayout>

        <!-- JS Pane -->
        <LinearLayout
            android:id="@+id/paneJs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入插件"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="支持多选，一次可选多个 .js 文件导入"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnImportJs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="导入插件" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <CheckBox
                    android:id="@+id/cbSelectAllJs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="全选" />

                <TextView
                    android:id="@+id/tvJsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="共 0 个插件"
                    android:gravity="center"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBatchDelJs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="删除选中"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
