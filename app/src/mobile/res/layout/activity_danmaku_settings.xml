<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="弹幕设置"
            android:textColor="#0C0E12"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />
        <!-- 弹幕加载 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕加载"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放时自动加载弹幕"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <Switch android:id="@+id/switch_danmu_load" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumb="@drawable/xc_switch_thumb"/>
        </LinearLayout>
        <!-- 搜索接口 -->
        <LinearLayout
            android:id="@+id/card_danmu_api"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索接口"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_danmu_api_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="默认：弹弹play · 共 1 个源"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chev_v2" />
        </LinearLayout>
        <!-- 自动搜索 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动搜索"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放时自动搜索匹配的弹幕"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <Switch android:id="@+id/switch_danmu_autosearch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumb="@drawable/xc_switch_thumb"/>
        </LinearLayout>
        <!-- 爬虫优先 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="爬虫优先"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="优先使用爬虫源搜索弹幕"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <Switch android:id="@+id/switch_danmu_spider_first" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" android:thumb="@drawable/xc_switch_thumb"/>
        </LinearLayout>
        <!-- 弹幕开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕开关"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="播放时在画面上滚动显示弹幕"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <Switch android:id="@+id/switch_danmu_enable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:thumb="@drawable/xc_switch_thumb"/>
        </LinearLayout>
        <!-- 弹幕透明度 -->
        <LinearLayout
            android:id="@+id/card_danmu_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕透明度"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数值越低弹幕越淡"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/seek_danmu_alpha"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="70" />
            <TextView
                android:id="@+id/tv_danmu_alpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textColor="#0C0E12"
                android:textSize="14sp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
        <!-- 弹幕速度 -->
        <LinearLayout
            android:id="@+id/card_danmu_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕速度"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕滚过屏幕的快慢"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/xc_seg_container" android:padding="4dp">
                <TextView android:id="@+id/speed_slow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="慢" android:textSize="14sp" />
                <TextView android:id="@+id/speed_normal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="标准" android:textSize="14sp" android:background="@drawable/xc_seg_selected" />
                <TextView android:id="@+id/speed_fast" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="快" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 弹幕字号 -->
        <LinearLayout
            android:id="@+id/card_danmu_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕字号"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕文字的大小"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/xc_seg_container" android:padding="4dp">
                <TextView android:id="@+id/size_small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="小" android:textSize="14sp" />
                <TextView android:id="@+id/size_medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="中" android:textSize="14sp" android:background="@drawable/xc_seg_selected" />
                <TextView android:id="@+id/size_large" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="大" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- 弹幕显示区域 -->
        <LinearLayout
            android:id="@+id/card_danmu_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕显示区域"
                    android:textColor="#0C0E12"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="弹幕可以出现的画面范围"
                    android:textColor="#101216"
                    android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/xc_seg_container" android:padding="4dp">
                <TextView android:id="@+id/area_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="上半屏" android:textSize="13sp" android:background="@drawable/xc_seg_selected" />
                <TextView android:id="@+id/area_full" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="全屏" android:textSize="13sp" />
                <TextView android:id="@+id/area_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:text="下半屏" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
