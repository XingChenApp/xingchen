<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- 状态栏压暗罩（Hm-5）：状态栏白图标压任意自选壁纸无兜底，亮壁纸上看不清。
         高度由 HomeActivity 按状态栏真实 inset 写入（隐藏时归零），罩值与详情页顶罩同定值；
         层级在 container 之下、短剧舞台之下，只罩状态栏这一条，不压顶栏玻璃胶囊。 -->
    <View
        android:id="@+id/status_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/shape_page_top_scrim" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/navigation" />
    <com.fongmi.android.tv.ui.view.XcBottomBar
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/xc_bottombar_height"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/xc_float_margin"
        android:layout_marginEnd="@dimen/xc_float_margin"
        android:layout_marginBottom="@dimen/xc_bottombar_margin_bottom"
        android:background="@drawable/xc_bottombar_pill"
        android:elevation="@dimen/xc_elevation_float" />
</RelativeLayout>
