<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加 AI 服务商"
            android:textColor="#0C0E12"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="名称"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:padding="15dp"
            android:hint="例如：我的 DeepSeek"
            android:textColor="#0C0E12"
            android:textColorHint="#4B5563"
            android:textSize="15sp"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="协议"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <LinearLayout
            android:id="@+id/card_protocol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tv_protocol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OpenAI 兼容"
                android:textColor="#0C0E12"
                android:textSize="15sp" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chev_v2" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一键模板"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <LinearLayout
            android:id="@+id/card_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tv_template"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择模板快速填写"
                android:textColor="#0C0E12"
                android:textSize="15sp" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chev_v2" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Base URL"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:padding="15dp"
            android:hint="https://api.deepseek.com/v1"
            android:textColor="#0C0E12"
            android:textColorHint="#4B5563"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:padding="15dp"
            android:hint="sk-..."
            android:textColor="#0C0E12"
            android:textColorHint="#4B5563"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型"
            android:textColor="#374151"
            android:textSize="15sp"
            android:layout_marginBottom="6dp"
            android:paddingLeft="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/et_model"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/xc_setcard_v2"
                android:padding="15dp"
                android:hint="deepseek-chat"
                android:textColor="#0C0E12"
                android:textColorHint="#4B5563"
                android:textSize="15sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/btn_fetch_models"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/xc_setcard_v2"
                android:padding="15dp"
                android:text="获取"
                android:textColor="#E8A33D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="填写 Base URL 和 Key 后点「获取」，从接口拉取可用模型列表选择"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginBottom="14dp"
            android:paddingLeft="4dp" />

        <LinearLayout
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/xc_setcard_v2"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/tv_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试连接"
                android:textColor="#0C0E12"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="测试将产生少量 token 调用"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginBottom="14dp"
            android:paddingLeft="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/xc_setcard_v2"
                android:padding="15dp"
                android:gravity="center"
                android:text="取消"
                android:textColor="#374151"
                android:textSize="16sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/xc_setcard_v2"
                android:padding="15dp"
                android:gravity="center"
                android:text="保存"
                android:textColor="#E8A33D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
