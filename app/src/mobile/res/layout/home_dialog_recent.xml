<?xml version="1.0" encoding="utf-8"?>
<!-- 播放历史承接弹窗（树内无 recent 列表页，按各音乐列表独立页现行「列表点歌」模式承接） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/home_bg_card_white"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_recent"
        android:textColor="#1A1A1A"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/homeRecentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/homeRecentEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/home_no_recent"
        android:textColor="#5A5A5A"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
