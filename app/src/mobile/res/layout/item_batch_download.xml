<?xml version="1.0" encoding="utf-8"?>
<!-- 与详情页选集网格格子（adapter_episode_grid）同款：48dp 高、shape_detail_episode 底
     （activated＝品牌橙 #F0A400、未选近白）、黑字居中。选中态由宿主在绑定时 setActivated，
     与勾选数组同源，不再另挂勾选框（原胶囊条＋勾选框形态他 2026-11-13 截图亲判看不出选中）。 -->
<com.google.android.material.textview.MaterialTextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/name"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/shape_detail_episode"
    android:ellipsize="start"
    android:gravity="center"
    android:singleLine="true"
    android:textColor="@color/black"
    android:textSize="15sp"
    tools:text="20" />
