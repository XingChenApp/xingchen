<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_patch_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="补丁更新"
        android:textColor="#0C0E12"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/patch_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#3A4150"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/stage_state_1"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="等待"
            android:textColor="#7A8194"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验补丁完整"
            android:textColor="#101216"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/stage_state_2"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="等待"
            android:textColor="#7A8194"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验当前版本对得上"
            android:textColor="#101216"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/stage_state_3"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="等待"
            android:textColor="#7A8194"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验剩余空间"
            android:textColor="#101216"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/stage_state_4"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="等待"
            android:textColor="#7A8194"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本地拼包"
            android:textColor="#101216"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/stage_state_5"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:text="等待"
            android:textColor="#7A8194"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="验新包完整与签名"
            android:textColor="#101216"
            android:textSize="14sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/patch_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:progressTint="#E8A33D" />

    <TextView
        android:id="@+id/patch_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#5A6270"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/patch_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#B3261E"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/patch_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_patch_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="11dp"
        android:text="请稍候…"
        android:textColor="#8A5A00"
        android:textSize="14.5sp"
        android:textStyle="bold" />
</LinearLayout>
