<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingTop="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

<!-- 1. Theme Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主题"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前为浅色主题，界面明亮清爽"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_theme_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="浅色"
            android:textSize="14sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:background="@drawable/seg_selected"/>

        <TextView
            android:id="@+id/seg_theme_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="深色"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"/>

        <TextView
            android:id="@+id/seg_theme_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跟随系统"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</LinearLayout>

<!-- 2. Cover Size Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="首页封面"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中封面：一行显示 3 个海报"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_cover_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="小"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"/>

        <TextView
            android:id="@+id/seg_cover_medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中"
            android:textSize="14sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/seg_selected"/>

        <TextView
            android:id="@+id/seg_cover_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</LinearLayout>

<!-- 3. Orientation Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="封面方向"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="竖屏封面：海报按 2:3 竖版显示"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_orient_portrait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="竖屏"
            android:textSize="14sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/seg_selected"/>

        <TextView
            android:id="@+id/seg_orient_landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="横屏"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</LinearLayout>

<!-- 4. Ratio Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="封面比例"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="竖屏比例 2:3（竖版）"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_ratio_23"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:3"
            android:textSize="14sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:background="@drawable/seg_selected"/>

        <TextView
            android:id="@+id/seg_ratio_34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3:4"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"/>

        <TextView
            android:id="@+id/seg_ratio_916"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:16"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"/>
    </LinearLayout>
</LinearLayout>

<!-- 5. UI Style Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UI 风格"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="毛玻璃：面板半透明，透出壁纸"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/seg_container"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_ui_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="普通"
            android:textSize="14sp"
            android:textColor="#5A5F69"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"/>

        <TextView
            android:id="@+id/seg_ui_glass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="毛玻璃"
            android:textSize="14sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/seg_selected"/>
    </LinearLayout>
</LinearLayout>

<!-- 6. Glass Opacity Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="毛玻璃透明度"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#171B23"/>

        <TextView
            android:id="@+id/tv_alpha_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前 55%，越往右越通透"
            android:textSize="12sp"
            android:textColor="#5A5F69"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <SeekBar
        android:id="@+id/seek_alpha"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:max="100"
        android:progress="55"/>

    <TextView
        android:id="@+id/tv_alpha_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="55%"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#171B23"/>
</LinearLayout>

<!-- 7. Wallpaper Card -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_glass"
    android:padding="20dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="壁纸"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#171B23"/>

            <TextView
                android:id="@+id/tv_wp_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前：默认壁纸"
                android:textSize="12sp"
                android:textColor="#5A5F69"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/seg_container"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_wp_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认"
                android:textSize="14sp"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"
                android:background="@drawable/seg_selected"/>

            <TextView
                android:id="@+id/seg_wp_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本地"
                android:textSize="14sp"
                android:textColor="#5A5F69"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"/>

            <TextView
                android:id="@+id/seg_wp_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL"
                android:textSize="14sp"
                android:textColor="#5A5F69"
                android:paddingHorizontal="18dp"
                android:paddingVertical="10dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="模糊壁纸"
            android:textSize="15sp"
            android:textColor="#171B23"/>

        <Switch
            android:id="@+id/switch_blur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"/>
    </LinearLayout>
</LinearLayout>

</LinearLayout>
</ScrollView>
