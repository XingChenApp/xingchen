<?xml version="1.0" encoding="utf-8"?>
<!-- 封顶照 TypeDialog 同形：CustomRecyclerView 的 app:maxHeight 真量测封顶，代码侧再按屏高比例复写（FilterDialog.initView） -->
<com.fongmi.android.tv.ui.custom.CustomRecyclerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recycler"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_glass_white_sheet"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:paddingHorizontal="20dp"
    android:paddingVertical="20dp"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    app:maxHeight="376dp" />
