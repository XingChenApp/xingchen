diff --git a/libraries/ui_danmaku/src/main/java/androidx/media3/ui/danmaku/DanmakuView.java b/libraries/ui_danmaku/src/main/java/androidx/media3/ui/danmaku/DanmakuView.java
--- a/libraries/ui_danmaku/src/main/java/androidx/media3/ui/danmaku/DanmakuView.java
+++ b/libraries/ui_danmaku/src/main/java/androidx/media3/ui/danmaku/DanmakuView.java
@@ -302,6 +302,26 @@
     return new LiveStats(liveOffered, liveAdmitted, 0, 0, 0, 0, 0, activeItems.size());
   }
 
+  /**
+   * Returns the {@link Danmaku#userId} of the topmost visible danmaku whose last drawn bounds
+   * contain the point (view coordinates), or {@code null} when no item with a non-empty userId is
+   * hit. Bounds are recorded during drawing; items not yet drawn in the current frame have no
+   * bounds and are never hit. Intended for embedders that attach per-item actions (for example a
+   * like button) to danmaku items identified through {@code userId}.
+   */
+  public @Nullable String findDanmakuUserIdAt(float x, float y) {
+    for (int i = activeItems.size() - 1; i >= 0; i--) {
+      DanmakuRenderItem item = activeItems.get(i);
+      if (!item.hitValid || item.userId == null || item.userId.isEmpty()) {
+        continue;
+      }
+      if (x >= item.hitLeft && x <= item.hitRight && y >= item.hitTop && y <= item.hitBottom) {
+        return item.userId;
+      }
+    }
+    return null;
+  }
+
   /** Live-item render statistics. */
   public static final class LiveStats {
     public static final LiveStats EMPTY = new LiveStats(0L, 0L, 0L, 0L, 0L, 0, 0, 0);
