+  /**
+   * Returns the last drawn bounds (view coordinates) of the visible danmaku identified by
+   * {@code userId} whose {@code timeMs} is closest to {@code timeMs}, or {@code null} when no
+   * such item is currently drawn with valid bounds. Intended for embedders that anchor
+   * per-item action UI (for example an action popup) to the tapped danmaku, mirroring the
+   * identity resolution used with {@link #findDanmakuUserIdAt}.
+   */
+  public @Nullable RectF findDanmakuBounds(String userId, long timeMs) {
+    if (userId == null || userId.isEmpty()) {
+      return null;
+    }
+    DanmakuRenderItem best = null;
+    long bestDiff = Long.MAX_VALUE;
+    for (int i = activeItems.size() - 1; i >= 0; i--) {
+      DanmakuRenderItem item = activeItems.get(i);
+      if (!item.hitValid || !userId.equals(item.userId)) {
+        continue;
+      }
+      long diff = Math.abs(item.timeMs - timeMs);
+      if (diff < bestDiff) {
+        bestDiff = diff;
+        best = item;
+      }
+    }
+    if (best == null) {
+      return null;
+    }
+    return new RectF(best.hitLeft, best.hitTop, best.hitRight, best.hitBottom);
+  }
