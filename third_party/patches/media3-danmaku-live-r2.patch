@@ -253,0 +256,80 @@ public final class DanmakuView extends View {
+  /**
+   * Offers a batch of live-stream danmaku items for immediate display.
+   *
+   * <p>Items are marked as live and added to the render pool. They activate like regular items
+   * but can be removed en masse via {@link #clearLiveItems()}.
+   */
+  public void offerLiveBatch(java.util.List<Danmaku> items) {
+    if (released || items.isEmpty()) {
+      return;
+    }
+    for (int i = 0; i < items.size(); i++) {
+      Danmaku danmaku = items.get(i);
+      if (danmaku != null) {
+        danmaku.liveItem = true;
+      }
+    }
+    liveOffered += items.size();
+    addItems(items);
+    liveAdmitted += items.size();
+  }
+
+  /** Removes all live items from the active list and render pool. */
+  public void clearLiveItems() {
+    // Remove from active items.
+    int writeIndex = 0;
+    for (int i = 0; i < activeItems.size(); i++) {
+      DanmakuRenderItem item = activeItems.get(i);
+      if (item.liveItem) {
+        continue;
+      }
+      if (writeIndex != i) {
+        activeItems.set(writeIndex, item);
+      }
+      writeIndex++;
+    }
+    if (activeItems.size() > writeIndex) {
+      activeItems.subList(writeIndex, activeItems.size()).clear();
+    }
+    liveOffered = 0;
+    liveAdmitted = 0;
+    requestRedrawForExternalChange();
+  }
+
+  /** Returns live-item render statistics. */
+  public LiveStats getLiveStats() {
+    return new LiveStats(liveOffered, liveAdmitted, 0, 0, 0, 0, 0, activeItems.size());
+  }
+
+  /** Live-item render statistics. */
+  public static final class LiveStats {
+    public static final LiveStats EMPTY = new LiveStats(0L, 0L, 0L, 0L, 0L, 0, 0, 0);
+    public final long offered;
+    public final long admitted;
+    public final long droppedOverflow;
+    public final long droppedExpired;
+    public final long trackWaits;
+    public final int pending;
+    public final int highWaterMark;
+    public final int active;
+
+    public LiveStats(
+        long offered,
+        long admitted,
+        long droppedOverflow,
+        long droppedExpired,
+        long trackWaits,
+        int pending,
+        int highWaterMark,
+        int active) {
+      this.offered = offered;
+      this.admitted = admitted;
+      this.droppedOverflow = droppedOverflow;
+      this.droppedExpired = droppedExpired;
+      this.trackWaits = trackWaits;
+      this.pending = pending;
+      this.highWaterMark = highWaterMark;
+      this.active = active;
+    }
+  }
+
