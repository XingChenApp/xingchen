# Xingchen baseline patch: AVS3 P7 (Audio Vivid) DASH channel configuration.
#
# 基线：上游 media 锁定提交 3c2cbe8ac742c2fe15eff52f03eeb3b1b648848d。
#
# 内容：DashManifestParser 识别 AVS3 P7 声道配置 scheme
# （urn:avs:avs3:p7:2024:audio_channel_configuration），映射
# f20101 -> 2、f20203 -> 6、f20a04 -> 12，未知值保持 Format.NO_VALUE
# 不猜布局。media-lock.json 的 artifact_overrides 里 exoplayer-dash
# 所记 "E12 AVS3A P7 DASH" 即此项。后像与现行工作树逐字一致。
# 本文件由 webhtv 的零上下文旧补丁按 2026-10-23 口径重生成；旧补丁还
# 带 DashManifestParserTest 的测试改动，测试不进产物，本版只取主源码。
diff --git a/libraries/exoplayer_dash/src/main/java/androidx/media3/exoplayer/dash/manifest/DashManifestParser.java b/libraries/exoplayer_dash/src/main/java/androidx/media3/exoplayer/dash/manifest/DashManifestParser.java
index 5dc5ca1..1088421 100644
--- a/libraries/exoplayer_dash/src/main/java/androidx/media3/exoplayer/dash/manifest/DashManifestParser.java
+++ b/libraries/exoplayer_dash/src/main/java/androidx/media3/exoplayer/dash/manifest/DashManifestParser.java
@@ -105,6 +105,10 @@ public class DashManifestParser extends DefaultHandler
         Format.NO_VALUE, 1, 2, 3, 4, 5, 6, 8, 2, 3, 4, 7, 8, 24, 8, 12, 10, 12, 14, 12, 14
       };
 
+  /** Maps AVS3 P7 Audio Vivid DASH channel configuration values to channel counts. */
+  private static final String AVS3A_P7_AUDIO_CHANNEL_CONFIGURATION_SCHEME =
+      "urn:avs:avs3:p7:2024:audio_channel_configuration";
+
   private final XmlPullParserFactory xmlParserFactory;
 
   public DashManifestParser() {
@@ -1609,6 +1613,9 @@ public class DashManifestParser extends DefaultHandler
       case "tag:dolby.com,2015:dash:audio_channel_configuration:2015":
         audioChannels = parseDolbyAC4ChannelConfiguration(xpp, codecs);
         break;
+      case AVS3A_P7_AUDIO_CHANNEL_CONFIGURATION_SCHEME:
+        audioChannels = parseAvs3aP7ChannelConfiguration(xpp);
+        break;
       default:
         audioChannels = Format.NO_VALUE;
         break;
@@ -2096,6 +2103,27 @@ public class DashManifestParser extends DefaultHandler
         : Format.NO_VALUE;
   }
 
+  /**
+   * Parses the AVS3 P7 Audio Vivid channel configuration values used by the test-library MPDs.
+   * Unknown values remain unspecified rather than being guessed as a speaker layout.
+   */
+  protected static int parseAvs3aP7ChannelConfiguration(XmlPullParser xpp) {
+    @Nullable String value = xpp.getAttributeValue(null, "value");
+    if (value == null) {
+      return Format.NO_VALUE;
+    }
+    switch (Ascii.toLowerCase(value)) {
+      case "f20101":
+        return 2;
+      case "f20203":
+        return 6;
+      case "f20a04":
+        return 12;
+      default:
+        return Format.NO_VALUE;
+    }
+  }
+
   /**
    * Parses the number of channels from the value attribute of an AudioChannelConfiguration with
    * schemeIdUri "tag:dts.com,2014:dash:audio_channel_configuration:2012" as defined by Annex G
